<UserControl x:Class="Airalnes.Views.Controls.PaymentUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Airalnes.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    <Grid>
        <materialDesign:Card UniformCornerRadius="0" >
            <Grid  Background="#100E17" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="30"/>
                    </Style>
                </Grid.Resources>
                <Grid Grid.Column="0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,1">
                            <GradientStop Color="#a300f5" Offset="0"/>
                            <GradientStop Color="#ea1cfc" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <ListView Margin="0 15">
                        <ListViewItem HorizontalAlignment="Center" Margin="0 15">
                            <Grid>
                                <Button x:Name="UserButton" Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left"
                    BorderBrush="{x:Null}" Foreground="White" Background="{x:Null}" Click="UserButton_Click">
                                    <StackPanel Margin="-5">
                                        <materialDesign:PackIcon Kind="AccountCircle"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="UserPopup" Placement="Right" PlacementTarget="{Binding ElementName=UserButton}" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="10">
                                    <Border Background="#100E17" CornerRadius="8" Padding="10" Effect="{DynamicResource MaterialDesignShadowDepth2}">
                                        <StackPanel>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Click="Logout_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🚪" Margin="0 0 5 0" Foreground="White"/>
                                                    <TextBlock Text="Log out" Foreground="White"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0 0">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                 Foreground="White" Background="{x:Null}" x:Name="Airplane" Click="Airplane_Click">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="AirplaneMarker"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0 10">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                Foreground="White" Background="{x:Null}" x:Name="History" Click="HistoryButton_Click">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="Calendar"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                Foreground="White" Background="{x:Null}">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="Cog"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                    </ListView>
                </Grid>
                <Grid Grid.Column="1">
                    <TextBlock Text="Payment" FontSize="38"   Margin="0 0 0 390" Foreground="White" FontFamily="pack://application:,,,/Resources/Fonts/#Lady Marmalade"
                       HorizontalAlignment="Center" VerticalAlignment="Center" >
                    </TextBlock>
                    <StackPanel Margin="10 50 10 10">
                        <Border Margin="10 85 10 0" Padding="10" CornerRadius="25" Height="150" >
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,1">
                                    <GradientStop Color="#007bff" Offset="0"/>
                                    <GradientStop Color="#70b5ff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="FontSize" Value="16"/>
                                    </Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Width" Value="20"/>
                                        <Setter Property="Height" Value="20"/>
                                    </Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="60"/>
                                    </Style>
                                </Grid.Resources>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="White" CornerRadius="10" Width="130" Margin="15 0 0 0">
                                        <StackPanel >
                                            <TextBlock Text="Cost" HorizontalAlignment="left" Margin="10 5 0 0" />
                                            <TextBox Margin="-5 0 0 0" materialDesign:TextFieldAssist.UnderlineBrush="Transparent"  x:Name="CostTextBox" Style="{StaticResource MaterialDesignTextBox}" Width="110"
                                                     Height="30" FontSize="16" IsReadOnly="True"/>
                                            <materialDesign:PackIcon Kind="Cash" Margin="99 -24 0 0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White" CornerRadius="10" Width="200"  Margin="15 0 0 0">
                                        <StackPanel >
                                            <TextBlock Text="Card" HorizontalAlignment="left" Margin="10 5 0 0" />
                                            <TextBox Margin="-5 0 0 0" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" Width="180"  PreviewTextInput="TextBox_PreviewTextInput"
                                                     TextChanged="CardNumberTextBox_TextChanged" MaxLength="19" x:Name="CardNumberTextBox" Style="{StaticResource MaterialDesignTextBox}" Height="30" FontSize="16"/>
                                            <materialDesign:PackIcon Kind="CreditCard" Margin="168 -24 0 0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White" CornerRadius="10" Width="130" Margin="15 0 0 0">
                                        <StackPanel >
                                            <TextBlock Text="CVV" HorizontalAlignment="left" Margin="10 5 0 0" />
                                            <TextBox Margin="-5 0 0 0" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" MaxLength="3" PreviewTextInput="TextBox_PreviewTextInput"
                                                     x:Name="CVVTextBox" Style="{StaticResource MaterialDesignTextBox}" Width="110" Height="30" FontSize="16"/>
                                            <materialDesign:PackIcon Kind="CreditCard" Margin="99 -24 0 0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White" CornerRadius="10" Width="130"  Margin="15 0 0 0">
                                        <StackPanel >
                                            <TextBlock Text="Date Card" HorizontalAlignment="left" Margin="10 5 0 0" />
                                            <TextBox Margin="-5 0 0 0" materialDesign:TextFieldAssist.UnderlineBrush="Transparent"  MaxLength="5" TextChanged="DateCardTextBox_TextChanged"
                                                     PreviewTextInput="TextBox_PreviewTextInput" x:Name="DateCardTextBox" Style="{StaticResource MaterialDesignTextBox}" Width="110" Height="30" FontSize="16"/>
                                            <materialDesign:PackIcon Kind="CreditCard" Margin="99 -24 0 0" />
                                        </StackPanel>
                                    </Border>
                                    <Button  Style="{StaticResource MaterialDesignFloatingActionButton}" Background="#000454" Foreground="White" FontFamily="Segoe UI"
                                             Height="60" Width="60"  Margin="30 0 0 0" BorderBrush="#000454" Click="PayButton_Click">
                                        <materialDesign:PackIcon Kind="AccountCreditCardOutline" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                                           x:Name="GlobalError" Margin="400 130 0 0" Visibility="Visible"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="850 0 0 0">
                        <Button  Margin="12 12 10 0" Height="30" Width="30" Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Close" Background="{x:Null}" 
            x:Name="ButtonExit" Click="ButtonExit_Click" >
                            <materialDesign:PackIcon Kind="Close" Foreground="White" Height="20" Width="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
