<UserControl x:Class="Airalnes.Views.Controls.HistoryFlightsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Airalnes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000">
    <Grid>
        <materialDesign:Card UniformCornerRadius="0" >
            <Grid  Background="#100E17" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Width" Value="35"/>
                        <Setter Property="Height" Value="35"/>
                    </Style>
                </Grid.Resources>
                <Grid Grid.Column="0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,1">
                            <GradientStop Color="#a300f5" Offset="0"/>
                            <GradientStop Color="#ea1cfc" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <ListView >
                        <ListViewItem HorizontalAlignment="Center" Margin="0 14">
                            <Grid>
                                <Button x:Name="UserButton" Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left"
   BorderBrush="{x:Null}" Foreground="White" Background="{x:Null}" Click="UserButton_Click" Height="100">
                                    <StackPanel Margin="-5">
                                        <materialDesign:PackIcon Kind="AccountCircle"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="UserPopup" Placement="Right" PlacementTarget="{Binding ElementName=UserButton}" 
  StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="10">
                                    <Border Background="#100E17" CornerRadius="8" Padding="10" Effect="{DynamicResource MaterialDesignShadowDepth2}">
                                        <StackPanel>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Click="Logout_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🚪" Margin="0 0 5 0" Foreground="White"/>
                                                    <TextBlock Text="Log out" Foreground="White"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
Foreground="White" Background="{x:Null}" x:Name="Airplane" Click="Airplane_Click" Height="100" >
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="AirplaneMarker"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0 11">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                   Foreground="White" Background="{x:Null}" Click="HistoryButton_Click" Height="100">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="Calendar"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                    </ListView>
                </Grid>
                <Grid Grid.Column="1">
                    <StackPanel Margin="0 0 0 0">
                        <Border Margin="10" Padding="10" CornerRadius="25" Height="430">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,1">
                                    <GradientStop Color="#007bff" Offset="0"/>
                                    <GradientStop Color="#70b5ff" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="All Flights" FontSize="38" Foreground="White" FontFamily="pack://application:,,,/Resources/Fonts/#Lady Marmalade"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" >
                                </TextBlock>
                                <Button  Margin="820 -45 0 0" Height="30" Width="30" Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Close" Background="{x:Null}" 
                                         x:Name="ButtonExit" Click="ButtonExit_Click" >
                                    <materialDesign:PackIcon Kind="Close" Foreground="White" Height="20" Width="20"/>
                                </Button>

                                <StackPanel >
                                    <DataGrid x:Name="FlightsDataGrid" CellStyle="{DynamicResource DataGridCellStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Style="{DynamicResource DataGridStyle1}" 
                              IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableColumnVirtualization="True" Height="340">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="From" Binding="{Binding FromLocation}" Width="70"/>
                                            <DataGridTextColumn Header="To" Binding="{Binding ToLocation}" Width="60"/>
                                            <DataGridTextColumn Header="Departure" Binding="{Binding Departure}" Width="100"/>
                                            <DataGridTextColumn Header="Arrival" Binding="{Binding ReturnDate}" Width="100"/>
                                            <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="80"/>
                                            <DataGridTextColumn Header="№" Binding="{Binding FlightNumber}" Width="50"/>
                                            <DataGridTextColumn Header="Airplane" Binding="{Binding AirplaneName}" Width="100"/>
                                            <DataGridTextColumn Header="Time DP" Binding="{Binding TimeDP}" Width="100"/>
                                            <DataGridTextColumn Header="Time AR" Binding="{Binding TimeAR}" Width="100"/>
                                            <DataGridTemplateColumn Header="Op" IsReadOnly="True" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Margin="5 0 0 0" Style="{StaticResource gridRemoveButton}"  Click="DeleteFlight_Click">
                                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>


            </Grid>
        </materialDesign:Card>

    </Grid>
</UserControl>
