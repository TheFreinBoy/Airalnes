<UserControl x:Class="Airalnes.Views.Controls.HistoryBookingUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Airalnes.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <materialDesign:Card UniformCornerRadius="0" >
            <Grid  Background="#100E17" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="30"/>
                    </Style>
                </Grid.Resources>
                <Grid Grid.Column="0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,1">
                            <GradientStop Color="#a300f5" Offset="0"/>
                            <GradientStop Color="#ea1cfc" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <ListView Margin="0 15">
                        <ListViewItem HorizontalAlignment="Center" Margin="0 15">
                            <Grid>
                                <Button x:Name="UserButton" Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left"
                    BorderBrush="{x:Null}" Foreground="White" Background="{x:Null}" Click="UserButton_Click">
                                    <StackPanel Margin="-5">
                                        <materialDesign:PackIcon Kind="AccountCircle"/>
                                    </StackPanel>
                                </Button>

                                <Popup x:Name="UserPopup" Placement="Right" PlacementTarget="{Binding ElementName=UserButton}" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="10">
                                    <Border Background="#100E17" CornerRadius="8" Padding="10" Effect="{DynamicResource MaterialDesignShadowDepth2}">
                                        <StackPanel>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Click="Logout_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🚪" Margin="0 0 5 0" Foreground="White"/>
                                                    <TextBlock Text="Log out" Foreground="White"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0 0">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                 Foreground="White" Background="{x:Null}" x:Name="Airplane" Click="Airplane_Click">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="AirplaneMarker"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0 10">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                Foreground="White" Background="{x:Null}" x:Name="History" Click="HistoryButton_Click">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="Calendar"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                        <ListViewItem HorizontalAlignment="Center" Margin="0">
                            <Button Style="{StaticResource MaterialDesignFloatingActionButton}" HorizontalAlignment="Left" BorderBrush="{x:Null}"
                Foreground="White" Background="{x:Null}">
                                <StackPanel Margin="-5">
                                    <materialDesign:PackIcon Kind="Cog"></materialDesign:PackIcon>
                                </StackPanel>
                            </Button>
                        </ListViewItem>
                    </ListView>
                </Grid>
                <Grid Grid.Column="1">
                    
                    <Border CornerRadius="15" Margin="10 10 10 10 ">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,1">
                                <GradientStop Color="#007bff" Offset="0"/>
                                <GradientStop Color="#70b5ff" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="Your Bookings" FontSize="38" Foreground="White" FontFamily="pack://application:,,,/Resources/Fonts/#Lady Marmalade"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" >
                            </TextBlock>
                            <StackPanel Margin="5">
                                <DataGrid CellStyle="{DynamicResource DataGridCellStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Style="{DynamicResource DataGridStyle1}" 
                              IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" EnableColumnVirtualization="True" x:Name="BookingHistroryDataGrid" Height="310">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="From" Binding="{Binding Flight.FromLocation}" Width="70"/>
                                        <DataGridTextColumn Header="To" Binding="{Binding Flight.ToLocation}" Width="60"/>
                                        <DataGridTextColumn Header="Departure" Binding="{Binding Flight.Departure}" Width="100"/>
                                        <DataGridTextColumn Header="Arrival" Binding="{Binding Flight.ReturnDate}" Width="100"/>
                                        <DataGridTextColumn Header="Class" Binding="{Binding Flight.Class}" Width="80"/>
                                        <DataGridTextColumn Header="№" Binding="{Binding Flight.FlightNumber}" Width="50"/>
                                        <DataGridTextColumn Header="Airplane" Binding="{Binding Flight.AirplaneName}" Width="100"/>
                                        <DataGridTextColumn Header="Time DP" Binding="{Binding Flight.TimeDP}" Width="100"/>
                                        <DataGridTextColumn Header="Time AR" Binding="{Binding Flight.TimeAR}" Width="100"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="100"/>

                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Paid" HorizontalAlignment="Right" Width="100" materialDesign:ButtonAssist.CornerRadius="15" Margin="0 0 10 0"
                                        Click="PaidButton_Click" Background="#ff1f75">
                                    
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="650 0 0 0">
                        <Button  Margin="5 25 20 0" Height="30" Width="30" Style="{StaticResource MaterialDesignFloatingActionButton}" ToolTip="Close" Background="{x:Null}" 
                                x:Name="ButtonExit" Click="ButtonExit_Click" >
                            <materialDesign:PackIcon Kind="Close" Foreground="White" Height="20" Width="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
